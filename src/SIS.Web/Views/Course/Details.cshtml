@model SIS.Web.ViewModels.CourseViewModel

@{
    ViewData["Title"] = "Course Details";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-book me-2"></i>Course Details</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Course Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>@Html.DisplayNameFor(model => model.CourseCode)</dt>
                                <dd><strong>@Html.DisplayFor(model => model.CourseCode)</strong></dd>

                                <dt>@Html.DisplayNameFor(model => model.CourseName)</dt>
                                <dd>@Html.DisplayFor(model => model.CourseName)</dd>

                                <dt>@Html.DisplayNameFor(model => model.Description)</dt>
                                <dd>@(Model.Description ?? "No description")</dd>

                                <dt>@Html.DisplayNameFor(model => model.Credits)</dt>
                                <dd>@Html.DisplayFor(model => model.Credits) Credits</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>@Html.DisplayNameFor(model => model.DepartmentName)</dt>
                                <dd>@(Model.DepartmentName ?? "N/A")</dd>

                                <dt>@Html.DisplayNameFor(model => model.TeacherName)</dt>
                                <dd>@(Model.TeacherName ?? "Unassigned")</dd>

                                <dt>@Html.DisplayNameFor(model => model.SemesterName)</dt>
                                <dd>@(Model.SemesterName ?? "N/A")</dd>

                                <dt>@Html.DisplayNameFor(model => model.Status)</dt>
                                <dd>
                                    @if (Model.Status == "Active")
                                    {
                                        <span class="badge bg-success">@Model.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Model.Status</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Schedule & Location</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>@Html.DisplayNameFor(model => model.Schedule)</dt>
                                <dd>@(Model.Schedule ?? "Not scheduled")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>@Html.DisplayNameFor(model => model.Room)</dt>
                                <dd>@(Model.Room ?? "N/A")</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-users me-2"></i>Enrolled Students (@Model.CurrentEnrollment / @Model.MaxCapacity)</h5>
                </div>
                <div class="card-body">
                    @{
                        var enrollments = ViewBag.Enrollments as IEnumerable<SIS.Application.DTOs.EnrollmentDto>;
                    }
                    @if (enrollments != null && enrollments.Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Student Number</th>
                                    <th>Student Name</th>
                                    <th>Status</th>
                                    <th>Grade</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var enrollment in enrollments)
                                {
                                    <tr>
                                        <td>@enrollment.StudentNumber</td>
                                        <td>@enrollment.StudentName</td>
                                        <td>
                                            <span class="badge @(enrollment.Status == "Enrolled" ? "bg-success" : "bg-secondary")">
                                                @enrollment.Status
                                            </span>
                                        </td>
                                        <td>@(enrollment.LetterGrade ?? "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No students enrolled yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Capacity</h5>
                </div>
                <div class="card-body text-center">
                    @{
                        var percentage = Model.MaxCapacity > 0 ? (Model.CurrentEnrollment * 100 / Model.MaxCapacity) : 0;
                        var colorClass = percentage >= 90 ? "bg-danger" : (percentage >= 70 ? "bg-warning" : "bg-success");
                    }
                    <div class="progress mb-3" style="height: 25px;">
                        <div class="progress-bar @colorClass" role="progressbar" style="width: @percentage%;" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                            @percentage%
                        </div>
                    </div>
                    <p>
                        <strong>@Model.AvailableSeats</strong> seats available
                    </p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit me-1"></i>Edit Course
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Delete Course
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
