@model SIS.Web.ViewModels.CourseViewModel

@{
    ViewData["Title"] = "Delete Course";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-trash-alt me-2 text-danger"></i>Delete Course</h2>
        </div>
    </div>

    <div class="alert alert-warning" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Warning!</strong> Are you sure you want to delete this course? This action cannot be undone.
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Course Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl>
                        <dt>@Html.DisplayNameFor(model => model.CourseCode)</dt>
                        <dd>@Html.DisplayFor(model => model.CourseCode)</dd>

                        <dt>@Html.DisplayNameFor(model => model.CourseName)</dt>
                        <dd>@Html.DisplayFor(model => model.CourseName)</dd>

                        <dt>@Html.DisplayNameFor(model => model.Credits)</dt>
                        <dd>@Html.DisplayFor(model => model.Credits) Credits</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl>
                        <dt>@Html.DisplayNameFor(model => model.DepartmentName)</dt>
                        <dd>@(Model.DepartmentName ?? "N/A")</dd>

                        <dt>@Html.DisplayNameFor(model => model.TeacherName)</dt>
                        <dd>@(Model.TeacherName ?? "Unassigned")</dd>

                        <dt>Current Enrollment</dt>
                        <dd>@Model.CurrentEnrollment / @Model.MaxCapacity students</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
