@model SIS.Web.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-trash-alt me-2 text-danger"></i>Delete Student</h2>
        </div>
    </div>

    <div class="alert alert-warning" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Warning!</strong> Are you sure you want to delete this student? This action cannot be undone.
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Student Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl>
                        <dt>@Html.DisplayNameFor(model => model.StudentNumber)</dt>
                        <dd>@Html.DisplayFor(model => model.StudentNumber)</dd>

                        <dt>@Html.DisplayNameFor(model => model.FullName)</dt>
                        <dd>@Html.DisplayFor(model => model.FullName)</dd>

                        <dt>@Html.DisplayNameFor(model => model.Email)</dt>
                        <dd>@Html.DisplayFor(model => model.Email)</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl>
                        <dt>@Html.DisplayNameFor(model => model.GradeLevel)</dt>
                        <dd>Grade @Html.DisplayFor(model => model.GradeLevel)</dd>

                        <dt>@Html.DisplayNameFor(model => model.Status)</dt>
                        <dd>
                            <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">
                                @Model.Status
                            </span>
                        </dd>

                        <dt>@Html.DisplayNameFor(model => model.EnrollmentDate)</dt>
                        <dd>@Model.EnrollmentDate.ToString("MMMM dd, yyyy")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
