@model SIS.Web.ViewModels.EditEnrollmentViewModel

@{
    ViewData["Title"] = "Edit Enrollment";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-edit me-2"></i>Edit Enrollment</h2>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="StudentId" />
                <input type="hidden" asp-for="CourseId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <div class="col-md-6">
                        <h5 class="mb-3">Enrollment Information</h5>

                        <div class="mb-3">
                            <label class="form-label">Student</label>
                            <input type="text" class="form-control" value="@Model.StudentName" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Course</label>
                            <input type="text" class="form-control" value="@Model.CourseName" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Enrolled">Enrolled</option>
                                <option value="Dropped">Dropped</option>
                                <option value="Completed">Completed</option>
                                <option value="Waitlisted">Waitlisted</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="mb-3">Grade Information</h5>

                        <div class="mb-3">
                            <label asp-for="Grade" class="form-label">Grade (%)</label>
                            <input asp-for="Grade" class="form-control" type="number" step="0.1" min="0" max="100" />
                            <span asp-validation-for="Grade" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LetterGrade" class="form-label"></label>
                            <select asp-for="LetterGrade" class="form-select">
                                <option value="">Select Letter Grade</option>
                                <option value="A+">A+</option>
                                <option value="A">A</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B">B</option>
                                <option value="B-">B-</option>
                                <option value="C+">C+</option>
                                <option value="C">C</option>
                                <option value="C-">C-</option>
                                <option value="D+">D+</option>
                                <option value="D">D</option>
                                <option value="D-">D-</option>
                                <option value="F">F</option>
                            </select>
                            <span asp-validation-for="LetterGrade" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
