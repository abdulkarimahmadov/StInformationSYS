@model SIS.Web.ViewModels.EnrollmentViewModel

@{
    ViewData["Title"] = "Delete Enrollment";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-trash-alt me-2 text-danger"></i>Delete Enrollment</h2>
        </div>
    </div>

    <div class="alert alert-warning" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Warning!</strong> Are you sure you want to delete this enrollment? This action cannot be undone.
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Enrollment Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl>
                        <dt>Student</dt>
                        <dd>@Model.StudentNumber - @Model.StudentName</dd>

                        <dt>Course</dt>
                        <dd>@Model.CourseCode - @Model.CourseName</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl>
                        <dt>@Html.DisplayNameFor(model => model.EnrollmentDate)</dt>
                        <dd>@Model.EnrollmentDate.ToString("MMMM dd, yyyy")</dd>

                        <dt>@Html.DisplayNameFor(model => model.Status)</dt>
                        <dd>
                            <span class="badge @(Model.Status == "Enrolled" ? "bg-success" : "bg-secondary")">
                                @Model.Status
                            </span>
                        </dd>

                        <dt>Grade</dt>
                        <dd>@(Model.LetterGrade ?? "N/A")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
