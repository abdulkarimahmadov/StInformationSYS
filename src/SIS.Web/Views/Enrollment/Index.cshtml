@model IEnumerable<SIS.Web.ViewModels.EnrollmentViewModel>

@{
    ViewData["Title"] = "Enrollments";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2><i class="fas fa-clipboard-list me-2"></i>Enrollments</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>New Enrollment
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Student</th>
                            <th>Course</th>
                            <th>Enrollment Date</th>
                            <th>Status</th>
                            <th>Grade</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var enrollment in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@enrollment.StudentNumber</strong><br />
                                        <small class="text-muted">@enrollment.StudentName</small>
                                    </td>
                                    <td>
                                        <strong>@enrollment.CourseCode</strong><br />
                                        <small class="text-muted">@enrollment.CourseName</small>
                                    </td>
                                    <td>@enrollment.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @switch (enrollment.Status)
                                        {
                                            case "Enrolled":
                                                <span class="badge bg-success">@enrollment.Status</span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-info">@enrollment.Status</span>
                                                break;
                                            case "Dropped":
                                                <span class="badge bg-danger">@enrollment.Status</span>
                                                break;
                                            case "Waitlisted":
                                                <span class="badge bg-warning">@enrollment.Status</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@enrollment.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(enrollment.LetterGrade))
                                        {
                                            <strong>@enrollment.LetterGrade</strong>
                                            @if (enrollment.Grade.HasValue)
                                            {
                                                <small class="text-muted">(@enrollment.Grade.Value.ToString("F1")%)</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@enrollment.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@enrollment.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@enrollment.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <i class="fas fa-info-circle me-2"></i>No enrollments found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
